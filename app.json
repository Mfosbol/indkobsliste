{
  "expo": {
    "name": "Indkøbsliste",
    "slug": "indkobsliste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Indkøbsliste bruger kameraet til at scanne stregkoder på dine varer."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Indkøbsliste bruger kameraet til at scanne stregkoder på dine varer."
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
